GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# GATEWAY_WORKSPACE=/absolute/path/to/your/git-project
# GATEWAY_DATA_DIR=/absolute/path/to/private/gateway-data
# GATEWAY_CODEX_HOME=/absolute/path/to/.codex
GATEWAY_SANDBOX=danger-full-access
# Optional defaults; the UI discovers available models and efforts from Codex:
# GATEWAY_MODEL=your-model-id
# GATEWAY_REASONING_EFFORT=high
GATEWAY_WORKERS=1
GATEWAY_ALLOW_OTHER_WORKSPACES=false
GATEWAY_RUN_TIMEOUT_SECONDS=1800
# Optional when headless CLI network requests need a system proxy:
# GATEWAY_PROXY_URL=http://127.0.0.1:your-proxy-port
# When publishing behind an existing port 8080 server:
# GATEWAY_PORT=18080
# GATEWAY_ROOT_PATH=/codex
